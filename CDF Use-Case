#2 #The code filtered for active Business Intelligence subscriptions, checked for multiple active subscriptions per hotel, and counted those with overlapping active periods before or on the migration.##

    bi_df = cdf[cdf['int_product_template__revenue_recognition_category'] == 'Business Intelligence']
    
    migration_start = '2024-11-01'
    migration_end = '2024-12-01'
    
    # Get all months up to and including the migration period
    migration_and_before_columns = [col for col in cdf.columns if col <= migration_end and col >= '2023-12-01']
    
    # check if a subscription is active (has revenue) in any month
    def is_active_in_period(row, columns):
        for col in columns:
            if row[col] > 0:
                return True
        return False
    
    # Identify active subscriptions
    bi_df['is_active'] = bi_df.apply(lambda row: is_active_in_period(row, migration_and_before_columns), axis=1)
    
    # Filter for active subscriptions only
    active_bi_df = bi_df[bi_df['is_active']]
    
    # Group by hotel to find those with multiple active subscriptions
    hotel_active_counts = active_bi_df.groupby('hotelinfo_id').size()
    hotels_with_multiple_active = hotel_active_counts[hotel_active_counts > 1].index.tolist() #It creates a list of hotels that have more than one active BI subscription before the migration.
    
    # check if these hotels have overlapping active periods (double revenue)
    hotels_with_migration_issues = 0
    
    for hotel_id in hotels_with_multiple_active:
        hotel_subscriptions = active_bi_df[active_bi_df['hotelinfo_id'] == hotel_id] #This line isolates all active BI subscriptions for a given hotel.
        
        # Check each month to see if there's more than one subscription with revenue
        for month in migration_and_before_columns:
            monthly_revenue = hotel_subscriptions[month]
            active_subscriptions_in_month = sum(monthly_revenue > 0)
            
            if active_subscriptions_in_month > 1:
                hotels_with_migration_issues += 1 #increases the count only if a hotel has overlapping subscriptions in the same month
                break  
    
    print(f"Number of hotels with migration issues (multiple active BI subscriptions on or before migration): {hotels_with_migration_issues}")

