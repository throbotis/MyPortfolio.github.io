    # Filter for Business Intelligence product subscriptions
    bi_df = cdf[cdf['int_product_template__revenue_recognition_category'] == 'Business Intelligence'].copy()
    
    # Ensure revenue columns are properly defined (only the date columns)
    revenue_columns = [col for col in cdf.columns if col.startswith('202')]
    
    # Convert these columns to numeric, ensuring non-numeric values are coerced to NaN
    bi_df[revenue_columns] = bi_df[revenue_columns].apply(pd.to_numeric, errors='coerce')
    
    # Define a function to check for gaps less than 6 months
    def has_gap_less_than_six_months(row):
        # Get revenue values as a numpy array
        revenues = np.array(row)
        
        # Find where revenue is active (greater than 0)
        active_months = np.where(revenues > 0)[0]
        
        # If only one month has revenue, there’s nothing to compare it to—no second active period exists to form a gap.
        if len(active_months) < 2:
            return False
        
        # Check for gaps by looking at differences between consecutive active months
        for i in range(len(active_months) - 1):
            gap = active_months[i+1] - active_months[i] - 1 #Subtracting 1 ensures that we count only the gap between them, excluding the active months themselves.
            # If there's a gap (difference > 0) and it's less than 6 months
            if 0 < gap < 6:
                return True
        
        return False
    
    # Apply the function to each subscription
    bi_df['has_gap_lt6'] = bi_df[revenue_columns].apply(has_gap_less_than_six_months, axis=1)
    
    # Count subscriptions with gaps less than 6 months
    cases_with_gap_lt6 = bi_df['has_gap_lt6'].sum()
    
    print('Number of Business Intelligence subscriptions with gaps less than 6 months:', cases_with_gap_lt6)

